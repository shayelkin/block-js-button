{
  "manifest_version": 3,
  "name": "Block JS Button",
  "version": "1.0.0",
  "description": "Click the toolbar button to block JavaScript on the current site.",
  "permissions": ["contentSettings", "activeTab", "tabs", "notifications"],
  "action": {
    "default_title": "Block JavaScript on this site",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
